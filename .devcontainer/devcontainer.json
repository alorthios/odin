{
  "name": "ODIN Battle Arena",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "ODIN multiplayer",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode.js-debug"
      ]
    }
  }
}
